HOST=0.0.0.0
PORT=3000
# Klucz tylko w backendzie. Nie używaj prefiksu VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Opcjonalny adres usługi zgodnej z OpenAI, używany również przez testy.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Własny losowy kod demo, 12–256 znaków. Brak kodu blokuje operacje AI.
DEMO_ACCESS_CODE=
# Tylko lokalne HTTP / Docker na NetBird. W publicznym demo z HTTPS ustaw true.
DEMO_COOKIE_SECURE=false
